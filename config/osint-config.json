      {
        "id": "multi_satellite_confirmation",
        "description": "동일 이벤트가 2개 이상 독립 위성/센서로 확인되면 신뢰도 가산",
        "pattern": "(?e observedBy ?s1) AND (?e observedBy ?s2) AND (?s1 != ?s2) AND (?s1 operatedBy ?o1) AND (?s2 operatedBy ?o2) AND (?o1 != ?o2) => (?e multiSatBoost +0.20)"
      },
      {
        "id": "cascading_disaster",
        "description": "같은 지역에서 시간차로 발생한 재해는 triggeredBy 추정",
        "pattern": "(?e1 inDomain dom-disaster) AND (?e2 inDomain dom-disaster) AND (?e1 locatedIn ?loc) AND (?e2 locatedIn ?loc) AND (?e2.start_date - ?e1.start_date in [0, 7days]) AND (?e1.phenomenon in {typhoon,earthquake,volcano}) AND (?e2.phenomenon in {flood,landslide,tsunami}) => (?e2 triggeredBy ?e1)"
      },
      {
        "id": "temporal_progression",
        "description": "같은 위치 시계열 관측은 partOfSeries",
        "pattern": "(?e1 locatedIn ?loc) AND (?e2 locatedIn ?loc) AND (?e1.phenomenon == ?e2.phenomenon) AND (?e2.observation_date > ?e1.observation_date) => (?e2 partOfSeries ?e1)"
      },
      {
        "id": "sensor_capability_match_sar",
        "description": "SAR 센서로 관측된 구름 잦은 지역 이벤트는 신뢰도 가산 (광학으로는 보기 어려움)",
        "pattern": "(?e usesSensor ?s) AND (?s sensor_type SAR) AND (?e cloudy_region true) => (?e sarBoost +0.10)"
      },
      {
        "id": "sensor_capability_match_tirs",
        "description": "열적외 센서로 관측된 화재·화산 이벤트는 신뢰도 가산",
        "pattern": "(?e usesSensor ?s) AND (?s sensor_type thermal_infrared) AND (?e.phenomenon in {wildfire,volcanic_eruption,industrial_accident}) => (?e thermalBoost +0.10)"
      },
      {
        "id": "sensor_capability_match_tracegas",
        "description": "초분광/대기 센서로 관측된 메탄·CO₂·NOx 플룸 이벤트는 신뢰도 가산",
        "pattern": "(?e usesSensor ?s) AND (?s sensor_type trace_gas) AND (?e.phenomenon in {methane_plume,co2_plume,air_pollution}) => (?e tracegasBoost +0.15)"
      },
      {
        "id": "sensor_capability_match_hires",
        "description": "고해상도 광학(≤1m)으로 관측된 인공구조물·차량 이벤트는 신뢰도 가산",
        "pattern": "(?e usesSensor ?s) AND (?s.resolution_m <= 1.0) AND (?e.phenomenon in {military_buildup,construction,industrial_accident}) => (?e hiResBoost +0.15)"
      },
      {
        "id": "official_source_trust",
        "description": "정부 우주기관·UN·재해기구 발표는 신뢰도 가산",
        "pattern": "(?e analyzedBy ?o) AND (?o.org_type in {space_agency,un_body,weather_agency}) => (?e officialBoost +0.15)"
      },
      {
        "id": "commercial_imagery_trust",
        "description": "상업 위성 사업자 직접 분석은 가산 (단 보도자료성은 cap)",
        "pattern": "(?e analyzedBy ?o) AND (?o.org_type commercial_imagery) AND (?e.is_press_release == false) => (?e commercialBoost +0.10)"
      },
      {
        "id": "korea_geo_focus",
        "description": "한반도·한국 EEZ 이벤트는 우선순위 가산",
        "pattern": "(?e inCountry ?c) AND (?c.iso_code in {KR,KP}) => (?e koreaBoost +0.10)"
      },
      {
        "id": "disaster_severity_priority",
        "description": "인명·인프라 피해 동반 자연재해는 보고서 1순위",
        "pattern": "(?e inDomain dom-disaster) AND (?e.severity high) => (?e priorityBoost +0.20)"
      },
      {
        "id": "before_after_credibility",
        "description": "전후 비교 영상이 있는 이벤트는 신뢰도 가산",
        "pattern": "(?e before_after_available true) => (?e baCredibilityBoost +0.10)"
      }
    ],
