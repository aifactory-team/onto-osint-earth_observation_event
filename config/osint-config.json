    "report_language": "ko",
    "lookback_days": 14,
    "schedule_cron": "0 23 * * *",
    "schedule_description": "KST 08:00 매일 (전날 공개된 위성영상 분석 + 향후 예정 관측 캠페인)",
    "geo_focus": {
      "scope": "global",
      "label": "전 지구",
      "rationale": "지구관측 이벤트는 글로벌 — 그러나 한반도(KOMPSAT 우선 관측)와 주변 해역은 가산점",
      "priority_regions": [
        { "id": "geo-korea", "name": "한반도", "boost": 0.10, "rationale": "KOMPSAT/CAS500 한반도 우선 관측 + 한국어 보고 우선순위" },
        { "id": "geo-east-sea", "name": "동해 / East Sea", "boost": 0.05, "rationale": "한국 EEZ" },
        { "id": "geo-yellow-sea", "name": "서해 / Yellow Sea", "boost": 0.05, "rationale": "한중 인접 해역 + 어선 활동 모니터링" },
        { "id": "geo-south-china-sea", "name": "남중국해", "boost": 0.05, "rationale": "분쟁 해역 — Maxar/Planet 자주 분석 보도" },
        { "id": "geo-amazon", "name": "아마존", "boost": 0.05, "rationale": "GFW 삼림 손실 핵심 모니터링" },
        { "id": "geo-arctic", "name": "북극", "boost": 0.05, "rationale": "기후 변화 핵심 신호" }
      ],
      "include_in_report": true
    },
