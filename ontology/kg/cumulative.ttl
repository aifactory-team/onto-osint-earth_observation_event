@prefix : <https://onto-osint.assi/eo-event/> .
@prefix eo: <https://onto-osint.assi/eo-event/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .

# === TBox (Ontology) ===
<https://onto-osint.assi/eo-event/ontology#> a owl:Ontology ;
    rdfs:label "Onto-OSINT Earth Observation Event Ontology"@en ;
    rdfs:comment "OSINT 온톨로지 스키마 — config/osint-config.json의 seed로부터 초기화되고, 매일 파이프라인 실행 시 자동 확장된다. 도메인: 위성영상으로 관측 가능한 지구상 이벤트 (Earth Observation Events)."@ko ;
    owl:versionInfo "1.0.0" ;
    dct:modified "2026-05-06"^^xsd:date .

eo:Entity a owl:Class ;
    rdfs:label "엔티티"@ko ;
    rdfs:comment "최상위 클래스"@ko .

eo:Event a owl:Class ;
    rdfs:subClassOf eo:Entity ;
    rdfs:label "이벤트"@ko ;
    rdfs:comment "위성영상으로 관측된 지구상 이벤트 (재해/인간활동/기후/농업/국방/인도주의)"@ko .

eo:Satellite a owl:Class ;
    rdfs:subClassOf eo:Entity ;
    rdfs:label "위성"@ko ;
    rdfs:comment "지구관측 위성 플랫폼"@ko .

eo:Sensor a owl:Class ;
    rdfs:subClassOf eo:Entity ;
    rdfs:label "센서"@ko ;
    rdfs:comment "위성 탑재 관측 센서 (광학/SAR/열적외/초분광/미량가스 등)"@ko .

eo:DataProduct a owl:Class ;
    rdfs:subClassOf eo:Entity ;
    rdfs:label "데이터제품"@ko ;
    rdfs:comment "특정 처리 수준의 위성 데이터 제품 (Sentinel-2 L2A 등)"@ko .

eo:Location a owl:Class ;
    rdfs:subClassOf eo:Entity ;
    rdfs:label "지역"@ko ;
    rdfs:comment "이벤트 발생 지리적 위치"@ko .

eo:Country a owl:Class ;
    rdfs:subClassOf eo:Entity ;
    rdfs:label "국가"@ko ;
    rdfs:comment "이벤트 발생 국가"@ko .

eo:Organization a owl:Class ;
    rdfs:subClassOf eo:Entity ;
    rdfs:label "기관"@ko ;
    rdfs:comment "위성 운영·분석·보도 기관 (우주기관/상업/UN/NGO/연구/매체)"@ko .

eo:Phenomenon a owl:Class ;
    rdfs:subClassOf eo:Entity ;
    rdfs:label "관측현상"@ko ;
    rdfs:comment "위성으로 관측 가능한 현상 유형"@ko .

eo:Domain a owl:Class ;
    rdfs:subClassOf eo:Entity ;
    rdfs:label "도메인"@ko ;
    rdfs:comment "이벤트가 속한 응용 도메인 (Disaster/HumanActivity/Climate/AgriMarine/Defense/Humanitarian)"@ko .

eo:observedBy a owl:ObjectProperty ;
    rdfs:label "관측위성"@ko ;
    rdfs:domain eo:Event ;
    rdfs:range eo:Satellite .

eo:usesSensor a owl:ObjectProperty ;
    rdfs:label "사용센서"@ko ;
    rdfs:domain eo:Event ;
    rdfs:range eo:Sensor .

eo:usesDataProduct a owl:ObjectProperty ;
    rdfs:label "사용데이터"@ko ;
    rdfs:domain eo:Event ;
    rdfs:range eo:DataProduct .

eo:locatedIn a owl:ObjectProperty ;
    rdfs:label "발생지역"@ko ;
    rdfs:domain eo:Event ;
    rdfs:range eo:Location .

eo:inCountry a owl:ObjectProperty ;
    rdfs:label "국가"@ko ;
    rdfs:domain eo:Event ;
    rdfs:range eo:Country .

eo:analyzedBy a owl:ObjectProperty ;
    rdfs:label "분석기관"@ko ;
    rdfs:domain eo:Event ;
    rdfs:range eo:Organization .

eo:reportedBy a owl:ObjectProperty ;
    rdfs:label "보도"@ko ;
    rdfs:domain eo:Event ;
    rdfs:range eo:Organization .

eo:manifests a owl:ObjectProperty ;
    rdfs:label "관측현상"@ko ;
    rdfs:domain eo:Event ;
    rdfs:range eo:Phenomenon .

eo:inDomain a owl:ObjectProperty ;
    rdfs:label "도메인"@ko ;
    rdfs:domain eo:Event ;
    rdfs:range eo:Domain .

eo:triggeredBy a owl:ObjectProperty ;
    rdfs:label "유발"@ko ;
    rdfs:domain eo:Event ;
    rdfs:range eo:Event .

eo:partOfSeries a owl:ObjectProperty ;
    rdfs:label "시리즈일부"@ko ;
    rdfs:domain eo:Event ;
    rdfs:range eo:Event .

eo:supersedes a owl:ObjectProperty ;
    rdfs:label "대체"@ko ;
    rdfs:domain eo:Event ;
    rdfs:range eo:Event .

eo:carriesSensor a owl:ObjectProperty ;
    rdfs:label "탑재센서"@ko ;
    rdfs:domain eo:Satellite ;
    rdfs:range eo:Sensor .

eo:operatedBy a owl:ObjectProperty ;
    rdfs:label "운영"@ko ;
    rdfs:domain eo:Satellite ;
    rdfs:range eo:Organization .

eo:produces a owl:ObjectProperty ;
    rdfs:label "제공제품"@ko ;
    rdfs:domain eo:Satellite ;
    rdfs:range eo:DataProduct .

eo:nearby a owl:ObjectProperty ;
    rdfs:label "근접지역"@ko ;
    rdfs:domain eo:Location ;
    rdfs:range eo:Location .

# Datatype properties (auto-declared)
eo:admin_level a owl:DatatypeProperty ; rdfs:range xsd:string .
eo:altitude_km a owl:DatatypeProperty ; rdfs:range xsd:decimal .
eo:area_km2 a owl:DatatypeProperty ; rdfs:range xsd:decimal .
eo:before_after_available a owl:DatatypeProperty ; rdfs:range xsd:boolean .
eo:carried_by a owl:DatatypeProperty ; rdfs:range xsd:string .
eo:category a owl:DatatypeProperty ; rdfs:range xsd:string .
eo:confidence a owl:DatatypeProperty ; rdfs:range xsd:decimal .
eo:country a owl:DatatypeProperty ; rdfs:range xsd:string .
eo:end_date a owl:DatatypeProperty ; rdfs:range xsd:date .
eo:first_seen a owl:DatatypeProperty ; rdfs:range xsd:date .
eo:format a owl:DatatypeProperty ; rdfs:range xsd:string .
eo:iso_code a owl:DatatypeProperty ; rdfs:range xsd:string .
eo:label a owl:DatatypeProperty ; rdfs:range xsd:string .
eo:last_seen a owl:DatatypeProperty ; rdfs:range xsd:date .
eo:lat a owl:DatatypeProperty ; rdfs:range xsd:decimal .
eo:launch_date a owl:DatatypeProperty ; rdfs:range xsd:date .
eo:level a owl:DatatypeProperty ; rdfs:range xsd:string .
eo:license a owl:DatatypeProperty ; rdfs:range xsd:string .
eo:lon a owl:DatatypeProperty ; rdfs:range xsd:decimal .
eo:mention_count a owl:DatatypeProperty ; rdfs:range xsd:integer .
eo:mission_status a owl:DatatypeProperty ; rdfs:range xsd:string .
eo:name a owl:DatatypeProperty ; rdfs:range xsd:string .
eo:notes a owl:DatatypeProperty ; rdfs:range xsd:string .
eo:observable_signature a owl:DatatypeProperty ; rdfs:range xsd:string .
eo:observation_date a owl:DatatypeProperty ; rdfs:range xsd:date .
eo:operator a owl:DatatypeProperty ; rdfs:range xsd:string .
eo:orbit_type a owl:DatatypeProperty ; rdfs:range xsd:string .
eo:org_type a owl:DatatypeProperty ; rdfs:range xsd:string .
eo:provider a owl:DatatypeProperty ; rdfs:range xsd:string .
eo:region a owl:DatatypeProperty ; rdfs:range xsd:string .
eo:resolution_m a owl:DatatypeProperty ; rdfs:range xsd:decimal .
eo:revisit_days a owl:DatatypeProperty ; rdfs:range xsd:decimal .
eo:satellite_unverified a owl:DatatypeProperty ; rdfs:range xsd:boolean .
eo:sensor_type a owl:DatatypeProperty ; rdfs:range xsd:string .
eo:severity a owl:DatatypeProperty ; rdfs:range xsd:string .
eo:start_date a owl:DatatypeProperty ; rdfs:range xsd:date .
eo:swath_km a owl:DatatypeProperty ; rdfs:range xsd:decimal .
eo:website a owl:DatatypeProperty ; rdfs:range xsd:anyURI .

